APP_NAME="SLID Emergency Travel Certificate"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_TIMEZONE=Africa/Freetown
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

AUTH_PASSWORD_RESET_EXPIRE=30
AUTH_PASSWORD_RESET_THROTTLE=300
AUTH_PASSWORD_TIMEOUT=1800

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FILESYSTEM_LOCAL_SERVE=false
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_ENCRYPTION=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production SMTP example:
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_ENCRYPTION=ssl
# MAIL_HOST=gtxm1330.siteground.biz
# MAIL_PORT=465
# MAIL_EHLO_DOMAIN=slid.gov.sl
# MAIL_USERNAME=noreply@slid.gov.sl
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=noreply@slid.gov.sl
# MAIL_FROM_NAME="Emergency Travel Certificate"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

WANGOV_ENABLED=false
WANGOV_BASE_URL=
WANGOV_ENDPOINT=/external-service
WANGOV_BEARER_TOKEN=
WANGOV_SERVICE_KEY=
WANGOV_SERVICE_CODE=slid003
WANGOV_SERVICE_SLUG=sierra-leone-emergency-travel-certificate
WANGOV_SERVICE_DISPLAY="Sierra Leone Emergency Travel Certificate"
WANGOV_ORIGIN="${APP_URL}"
WANGOV_ALLOWED_METHODS=
WANGOV_TIMEOUT=15
WANGOV_FALLBACK_APPLICANT_NIN=SLIDETC
WANGOV_CHECKOUT_ALLOWED_HOSTS=
WANGOV_WEBHOOK_SECRET=
WANGOV_WEBHOOK_IPS=
WANGOV_WEBHOOK_MAX_PAYLOAD_BYTES=20000

TESSERACT_BINARY=tesseract

FEATURE_EMERGENCY_TRAVEL_CERTIFICATE_ENABLED=true
FEATURE_BORDER_MANAGEMENT_ENABLED=false

SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_PRELOAD=false
SECURITY_CSP_ENABLED=true
SECURITY_UPGRADE_INSECURE_REQUESTS=false
SECURITY_SESSION_INTEGRITY_ENABLED=true
SECURITY_SESSION_BIND_USER_AGENT=true
SECURITY_SESSION_BIND_IP_PREFIX=true
SECURITY_SESSION_IPV4_PREFIX_BITS=24
SECURITY_SESSION_IPV6_PREFIX_BITS=64
SECURITY_STAFF_MFA_REQUIRED=false
SECURITY_STAFF_MFA_REQUIRE_CONFIRMED=true
SECURITY_STAFF_EMAIL_DOMAINS=immigration.gov.sl
SECURITY_MIN_SHARED_SECRET_LENGTH=32

SEED_ALLOW_DEFAULT_PASSWORDS=true
SEED_DEFAULT_PASSWORD=ChangeMe123!
SEED_SYSTEM_ADMIN_EMAIL=admin@immigration.gov.sl
SEED_SYSTEM_ADMIN_PASSWORD=
SEED_ETC_ISSUER_EMAIL=etc.issuer@immigration.gov.sl
SEED_ETC_ISSUER_PASSWORD=
SEED_EXECUTIVE_EMAIL=executive@immigration.gov.sl
SEED_EXECUTIVE_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
